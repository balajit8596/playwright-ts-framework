{
  "name": "playwright-ts-automation-framework",
  "version": "1.0.0",
  "description": "Scalable UI + API test automation framework using Playwright, TypeScript, Page Object Model and custom fixtures.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium tests/ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "lint": "tsc --noEmit"
  },
  "keywords": ["playwright", "typescript", "test-automation", "page-object-model"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
